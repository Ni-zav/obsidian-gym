views:
  - type: table
    name: Exercises
    filters:
      and:
        - file.inFolder("Templates/exercises")
        - not:
            - file.inFolder("Templates/exercises/_library")
    groupBy:
      property: muscle_group
      direction: ASC
    order:
      - file.name
      - tracking_mode
      - muscle_group
      - equipment
      - default_reps
      - default_weight_kg
      - default_duration_seconds
      - default_distance_km
      - default_rest_seconds
      - instructions
    sort:
      - property: muscle_group
        direction: ASC
      - property: file.name
        direction: ASC
