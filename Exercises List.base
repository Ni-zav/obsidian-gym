views:
  - type: table
    name: Exercises
    filters:
      and:
        - file.inFolder("Templates/exercises")
        - file.name != "Start"
        - file.name != "End"
        - file.name != "Custom"
        - not:
            - file.inFolder("Templates/exercises/_library")
    groupBy:
      property: muscle_group
      direction: ASC
    order:
      - file.name
      - muscle_group
      - equipment
      - timed
      - default_reps
      - default_duration_seconds
      - default_rest_seconds
      - instructions
    sort:
      - property: muscle_group
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.equipment: 152
      note.instructions: 367
    markers: none
    indentProperties: false
