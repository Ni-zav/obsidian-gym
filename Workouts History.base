formulas:
  Date: file.properties.date
  Sets: if(file.properties.Logs, max(0, file.properties.Logs.length - 2), 0)
properties:
  formula.Date:
    displayName: Date
  file.properties.ExercisesSummary:
    displayName: Exercises
views:
  - type: table
    name: History
    filters:
      and:
        - file.inFolder("Workouts")
        - not:
            - file.path.contains("/Log/")
    order:
      - formula.Date
      - file.name
      - status
      - workout_type
      - workout_place
      - formula.Sets
      - Total Volume
      - duration
      - ExercisesSummary
    sort:
      - property: formula.Date
        direction: DESC
      - property: file.ctime
        direction: DESC
    columnSize:
      note.duration: 122
    cardSize: 300
    rowHeight: medium
