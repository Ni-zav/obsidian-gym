formulas:
  Date: file.properties.date
properties:
  formula.Date:
    displayName: Date
views:
  - type: table
    name: History
    filters:
      and:
        - file.inFolder("Workouts")
        - not:
            - file.path.contains("/Log/")
    order:
      - formula.Date
      - file.name
      - status
      - workout_type
      - workout_place
      - working_set_count
      - total_volume
      - timed_seconds
      - distance_km
      - pr_count
      - duration_minutes
    sort:
      - property: formula.Date
        direction: DESC
      - property: file.ctime
        direction: DESC
    rowHeight: medium
