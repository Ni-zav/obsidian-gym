views:
  - type: table
    name: Routines
    filters:
      and:
        - file.inFolder("Templates/Workouts")
    groupBy:
      property: workout_type
      direction: ASC
    order:
      - file.name
      - workout_type
      - workout_place
      - exercise_plan
      - file.mtime
    sort:
      - property: workout_type
        direction: ASC
      - property: file.name
        direction: ASC
